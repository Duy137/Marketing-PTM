# ==============================================
# PTM AUTO POST — CẤU HÌNH HỆ THỐNG
# ==============================================
# Copy file này thành .env và điền các giá trị thực

# --- LLM API ---
# Chọn nhà cung cấp AI: gemini | openai | claude
LLM_PROVIDER=openai

# Tên model tương ứng với provider đã chọn
# Gemini:  gemini-2.0-flash | gemini-1.5-pro
# OpenAI:  gpt-4o | gpt-4o-mini
# Claude:  claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
LLM_MODEL=gpt-4o

# Điền key của provider bạn chọn (không cần điền các key còn lại)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- TELEGRAM BOT ---
# Tạo bot tại @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID của bạn — lấy bằng cách nhắn /start cho bot và dùng getUpdates
TELEGRAM_CHAT_ID=

# --- FACEBOOK GRAPH API ---
# Format mới: đánh số từ 1, hỗ trợ nhiều page
# Lấy Page ID và Token tại: developers.facebook.com → Graph API Explorer → me/accounts
# ==============================================
# PTM AUTO POST — CẤU HÌNH HỆ THỐNG
# ==============================================
# Copy file này thành .env và điền các giá trị thực

# --- LLM API ---
# Chọn nhà cung cấp AI: gemini | openai | claude
LLM_PROVIDER=openai

# Tên model tương ứng với provider đã chọn
# Gemini:  gemini-2.0-flash | gemini-1.5-pro
# OpenAI:  gpt-4o | gpt-4o-mini
# Claude:  claude-3-5-sonnet-20241022 | claude-3-haiku-20240307
LLM_MODEL=gpt-4o

# Điền key của provider bạn chọn (không cần điền các key còn lại)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- TELEGRAM BOT ---
# Tạo bot tại @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=
# Chat ID của bạn — lấy bằng cách nhắn /start cho bot và dùng getUpdates
TELEGRAM_CHAT_ID=

# --- FACEBOOK GRAPH API ---
# Lấy Page ID và Token tại: developers.facebook.com → Graph API Explorer → me/accounts
FACEBOOK_PAGE_1_NAME=
FACEBOOK_PAGE_1_ID=
FACEBOOK_PAGE_1_TOKEN=
# Thêm page thứ 2 (xóa dấu # để kích hoạt)
FACEBOOK_PAGE_2_NAME=
FACEBOOK_PAGE_2_ID=
FACEBOOK_PAGE_2_TOKEN=

# --- CÀI ĐẶT HỆ THỐNG ---
# Đường dẫn gốc của project (không cần sửa nếu chạy từ thư mục này)
PROJECT_ROOT=.

# Số ảnh gửi kèm bài (tối đa 4 ảnh/bài trên Facebook)
IMAGES_PER_POST=3


WEBHOOK_URL=